{
  "name": "cyprus-christian-tabernacle",
  "version": "0.1.0",
  "private": true,
  "description": "Official website of the Northern Cyprus Christian Tabernacle, sharing its sermons, songs, books and beliefs.",
  "keywords": [
    "church",
    "sermons",
    "worship",
    "nextjs",
    "aws"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makcood/cyprus-christian-tabernacle.git"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:css": "stylelint \"**/*.css\" --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --fix --cache",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "quality:fix": "npm run format:fix && npm run lint:fix && npm run lint:css:fix",
    "quality:check": "npm run format && npm run lint && npm run lint:css && npm run build && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
